{
  "name": "zar-browser",
  "version": "1.1.1",
  "homepage": "https://github.com/neo-zero23/Zar-Browser",
  "description": "Zar Browser: navegador minimalista basado en Electron, sin bloat.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder --win --linux --publish never"
  },
  "build": {
    "appId": "com.zar.browser",
    "productName": "Zar Browser",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "optimizations.js",
      "db.js",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zar Browser",
      "artifactName": "Zar-Browser-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] },
        { "target": "pacman", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "synopsis": "Navegador minimalista basado en Electron",
      "description": "Zar Browser: optimizacion antes de belleza.",
      "maintainer": "Zar",
      "vendor": "Zar",
      "artifactName": "zar-browser-${version}.${ext}"
    }
  },
  "keywords": [
    "browser",
    "minimal",
    "performance",
    "electron"
  ],
  "author": "neo-zero23 <neo-zero23@users.noreply.github.com>",
  "license": "MPL-2.0",
  "allowScripts": {
    "electron@41.10.7": true
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^41.10.7",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "cross-fetch": "^4.1.0"
  }
}
